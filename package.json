{
  "name": "route-discovery",
  "version": "1.0.0",
  "scripts": {
    "install:deps": "npm install && npx playwright install chromium",

    "routes:export": "php artisan route:list --json > routes.json",
    "routes:generate": "node generate-playwright-from-routes.js",

    "auto": "node advanced-generation.js",
    "auto:single": "node advanced-generation.js",
    "shallow": "node advanced-generation.js --shallow",

    "discover": "node discover-routes.js",

    "record": "node advanced-recording.js",

    "convert:playwright": "node convert-to-playwright.js",
    "convert:phpunit": "node convert-to-phpunit.js",

    "playback": "node playback.js",

    "test": "npx playwright test",
    "test:one": "npx playwright test --grep"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.0.0",
    "playwright": "^1.40.0"
  }
}