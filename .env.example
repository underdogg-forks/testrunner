APP_URL=http://example.test
LARAVEL_PATH=/example/path/to/laravel
ROUTES_JSON=routes.json
LOGIN_PATH=/login
DASHBOARD_PATH=/dashboard
E2E_EMAIL=testuser@example.test
E2E_PASSWORD=example123
HEADLESS=true
ASSUME_AUTHENTICATED=false

# Optional — URL parameter substitution for routes like /user/{external_id}
# Provide a JSON object mapping parameter names to real values.
# Note: if you set this in .env, wrap the value in single quotes to avoid Makefile issues.
# Example: ROUTE_PARAMS='{"external_id":"abc-123","id":"42"}'
ROUTE_PARAMS=

# Optional — error handling
STOP_ON_ERROR=false
STOP_ON_FAIL_ROUTE=false
SCREENSHOT_ON_ERROR=true
TRACE=true

# Optional — persisted skip list (added automatically on error)
SKIPPED_JSON=skipped.json

# Optional — output root for generated Playwright specs
E2E_TESTS_DIR=tests-playwright

# Optional — on every scanned page (make auto only), find "+"/add-row buttons
# and date/time pickers, exercise each one, and persist a real Playwright
# spec (tests-playwright/interactions-<timestamp>.spec.js) covering them.
# Off by default: it adds real per-page time and clicks live UI controls.
CRAWL_INTERACTIONS=false

# mind-the-gap: frontend form/DB constraint audit (see find-form-gaps.js /
# tests-playwright/form-db-gaps.spec.js). `make export-schema` runs
# `php artisan mind-the-gap:export-schema` inside DOCKER_CONTAINER to
# produce SCHEMA_JSON — set these to your real dev container's name and the
# app's path inside it (never a generic placeholder like "app"/"cli").
SCHEMA_JSON=schema.json
TENANT_SLUG=example
DOCKER_CONTAINER=example-workspace-1
DOCKER_APP_PATH=/var/www/example