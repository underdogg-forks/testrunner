APP_URL=http://example.test
LARAVEL_PATH=/example/path/to/laravel
ROUTES_JSON=routes.json
LOGIN_PATH=/login
DASHBOARD_PATH=/dashboard
E2E_EMAIL=testuser@example.test
E2E_PASSWORD=example123
HEADLESS=true
ASSUME_AUTHENTICATED=false

# Optional — URL parameter substitution for routes like /user/{external_id}
# Provide a JSON object mapping parameter names to real values.
# Note: if you set this in .env, wrap the value in single quotes to avoid Makefile issues.
# Example: ROUTE_PARAMS='{"external_id":"abc-123","id":"42"}'
ROUTE_PARAMS=

# Optional — error handling
STOP_ON_ERROR=false
STOP_ON_FAIL_ROUTE=false
SCREENSHOT_ON_ERROR=true
TRACE=true

# Optional — persisted skip list (added automatically on error)
SKIPPED_JSON=skipped.json

# Optional — output root for generated Playwright specs
E2E_TESTS_DIR=tests-playwright